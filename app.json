{
  "expo": {
    "name": "WAYLO",
    "slug": "WAYLO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "jsc",
    "scheme": "waylo",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waylo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "WAYLO needs camera access to take photos and scan QR codes",
        "NSPhotoLibraryUsageDescription": "WAYLO needs photo library access to save and upload photos",
        "NSMicrophoneUsageDescription": "WAYLO needs microphone access for video recording"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.waylo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false,
        "tsconfigPaths": true,
        "typedRoutes": true
      },
      "eas": {
        "projectId": "f91ffcd5-bc18-477a-a38a-399d9fac54ea"
      }
    },
    "owner": "waylo"
  }
}
